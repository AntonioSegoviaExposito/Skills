JIRA_BASE_URL="https://jira.example.com"   # include any context path, no trailing slash, e.g. https://jira.example.com/jira
JIRA_TOKEN=""                               # personal access token, sent as Bearer
JIRA_PROJECT="PROJ"                         # project key every JQL search is scoped to
JIRA_CURL_OPTS=""                           # optional extra curl flags, e.g. --resolve or --cacert
